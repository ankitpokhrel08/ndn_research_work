.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── Local agent / editor state (not part of the research) ─────────────────────
.claude/
.vscode/
.idea/
*.swp


# ── ndnSIM / waf build artifacts + crash dumps (regenerated on compile) ───────
NDNsim_v*/**/build/
NDNsim_v*/**/.lock-waf*
NDNsim_v*/**/.waf*-*/
NDNsim_v*/**/core
NDNsim_v3/ndnsim-research-main/ndn-research/31-10000-results/
*.o
*.so
*.so.*

# ── LaTeX build artifacts (keep the .tex source) ──────────────────────────────
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg

# ── Heavy data — NOT committed. Provided as a separate bundle (see DATA.md) ───
# The repo keeps code, notebooks, figures, docs, scenario sources, trained models,
# and tiny result tables. Raw traces + large derived CSVs are regenerated by the
# pipeline from the downloadable bundle.

# The data bundle zip itself (built for the GitHub Release, never committed)
ndn-data-bundle.zip
*.zip

# Raw simulation/emulation output — all NDNsim versions (v1..v4) + miniNDN.
# Matches both layouts: NDNsim_v*/ndn-research/results and
# NDNsim_v*/ndnsim-research-main/ndn-research/results.
NDNsim_v*/**/ndn-research/results/
miniNDN/Datacard/Logs/

# Large derived feature CSVs: ignore every processed CSV, then keep only the tiny
# result tables the findings docs reference (all < 1 MB).
NDNsim_v*/processed/*.csv
!NDNsim_v*/processed/detection_floor.csv
!NDNsim_v*/processed/attack_window_contrast.csv
!NDNsim_v*/processed/sweep_node_summary.csv
!NDNsim_v*/processed/ks_results.csv
!NDNsim_v*/processed/detection_latency.csv
!NDNsim_v*/processed/detection_per_node.csv
!NDNsim_v*/processed/spatial_localization.csv
miniNDN/Datacard/Datasets/*.csv
