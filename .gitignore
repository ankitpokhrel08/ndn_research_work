__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ── Jupyter ───────────────────────────────────────────────────────────────────
*.ipynb_checkpoints
.virtual_documents/

